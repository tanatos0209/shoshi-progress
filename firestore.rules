rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // One Google account, two apps, one project:
    //   shoshi-progress → users/{uid}/progress/...
    //   shoshi-ox       → users/{uid}/ox/...
    match /users/{uid}/{app}/{document=**} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && (app == "progress" || app == "ox");
    }
  }
}
